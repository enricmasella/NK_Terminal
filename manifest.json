{
    "manifest_version": 3,
    "name": "NK_Terminal",
    "short_name": "NK",
    "description": "NK_Terminal - retro terminal dashboard for new tab, with AI chat, widgets and an extensible command system.",
    "version": "2.0.0",
    "author": "enedil",
    "developer": {
        "name": "enedil"
    },
    "icons": {
        "16": "logo.png",
        "32": "logo.png",
        "48": "logo.png",
        "128": "logo.png",
        "512": "logo.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "NK_Terminal"
    },
    "chrome_url_overrides": {
        "newtab": "terminal.html"
    },
    "permissions": [
        "storage",
        "webNavigation",
        "tabs",
        "system.memory",
        "system.cpu",
        "system.storage"
    ],
    "host_permissions": [
        "https://wttr.in/*",
        "https://ip-api.com/*",
        "https://ipapi.co/*",
        "https://ipinfo.io/*",
        "https://geocoding-api.open-meteo.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://api.openai.com/*",
        "https://api.anthropic.com/*"
    ],
    "optional_host_permissions": [
        "*://*/*"
    ]
}
